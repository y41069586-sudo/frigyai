# Codemagic → frigyai → Settings → Environment variables
# Do NOT commit real values.
#
# Option A (recommended if you use a group): put ALL variables in group named exactly: frigy
#   (codemagic.yaml has  groups: [frigy]  — group name must match)
# Option B: leave Group EMPTY on each variable (Application-level) and remove groups: from codemagic.yaml
#
# iOS signing: also add Distribution .p12 in Codemagic Team → Code signing identities (see docs/CODEMAGIC.md).
# APP_STORE_CONNECT_* = API .p8 only; NOT the same as the distribution certificate private key.
#

APP_STORE_CONNECT_KEY_IDENTIFIER=P5FA563XP2
APP_STORE_CONNECT_ISSUER_ID=your-issuer-uuid-from-app-store-connect
APP_STORE_CONNECT_PRIVATE_KEY=<full AuthKey_P5FA563XP2.p8 — mark Secret>

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Required for store builds (Codemagic verify script fails without these):
VITE_REVENUECAT_API_KEY_IOS=appl_xxxx
VITE_REVENUECAT_API_KEY_ANDROID=goog_xxxx

# Optional (defaults in codemagic.yaml):
# VITE_REVENUECAT_ENTITLEMENT_ID=premium
# VITE_APPLE_BUNDLE_ID=com.frigyapp.app
