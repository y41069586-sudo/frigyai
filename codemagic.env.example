# Copy these names into Codemagic → frigyai → Settings → Environment variables
# Do NOT commit real values. See docs/CODEMAGIC.md

# --- Group: appstore_credentials (required for yaml "groups") ---
APP_STORE_CONNECT_KEY_IDENTIFIER=BFQ5G69F89
APP_STORE_CONNECT_ISSUER_ID=your-issuer-uuid-from-app-store-connect
APP_STORE_CONNECT_PRIVATE_KEY=<paste full AuthKey_BFQ5G69F89.p8 — mark Secret>

# --- Same group or Application-level (no group) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_REVENUECAT_API_KEY_IOS=appl_xxxx
VITE_REVENUECAT_ENTITLEMENT_ID=premium
VITE_APPLE_BUNDLE_ID=com.frigyapp.app
VITE_APPLE_CLIENT_ID=com.frigyapp.app
VITE_APPLE_REDIRECT_URI=https://app.frigy.app/auth/callback
VITE_PRIVACY_POLICY_URL=https://app.frigy.app/legal/datenschutz
