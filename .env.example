# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# OAuth return URL — only for local overrides (.env.development sets localhost automatically).
# Supabase Redirect URLs (exact paths — no query strings in allow list):
#   https://app.frigy.app/auth
#   frigy://callback
#   http://localhost:4137/auth
# Optional wildcard: https://app.frigy.app/**
# Site URL: https://app.frigy.app (no trailing slash, no wildcards)
# Google Cloud: only https://<project>.supabase.co/auth/v1/callback

# ChottuLink / App Links (replace with your ChottuLink project domain)
VITE_CHOTTULINK_HOST=frigy.chottu.link
VITE_CHOTTULINK_API_KEY=your-mobile-sdk-api-key
VITE_APP_WEB_HOST=app.frigy.app

# Apple Team ID for AASA (Xcode → Signing & Capabilities)
VITE_IOS_TEAM_ID=TEAMID

# RevenueCat (native iOS/Android in-app subscriptions — see docs/STORE_BILLING_SETUP.md)
VITE_REVENUECAT_API_KEY_IOS=appl_xxxxxxxx
VITE_REVENUECAT_API_KEY_ANDROID=goog_xxxxxxxx
VITE_REVENUECAT_ENTITLEMENT_ID=premium

# Sign in with Apple (Supabase Auth + native iOS)
VITE_APPLE_BUNDLE_ID=com.frigyapp.app
VITE_APPLE_CLIENT_ID=com.frigyapp.app
VITE_APPLE_REDIRECT_URI=https://app.frigy.app/auth/callback

# App Store Connect metadata (public URLs)
VITE_PRIVACY_POLICY_URL=https://app.frigy.app/legal/datenschutz
VITE_TERMS_URL=https://app.frigy.app/legal/agb
