// Copy to Secrets.xcconfig (gitignored) and fill in values from the React .env / Xcode build settings.

SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = your_anon_key
APP_WEB_HOST = app.frigy.app
OAUTH_REDIRECT_SCHEME = frigy
OAUTH_CALLBACK_HOST = callback
REVENUECAT_API_KEY = appl_your_ios_public_key
REVENUECAT_ENTITLEMENT_ID = premium

// Comma-separated emails that bypass the paywall (dev/tester accounts)
PAYWALL_BYPASS_EMAILS = dev@example.com,tester@example.com
