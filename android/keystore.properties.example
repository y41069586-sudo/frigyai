# Copy to android/keystore.properties (gitignored). Used for local ./gradlew bundleRelease only.
# Codemagic uses CM_KEYSTORE_* env vars when android_signing is configured in codemagic.yaml.
#
# Generate a release keystore once (keep backup + passwords safe):
#   keytool -genkey -v -keystore frigy-release.keystore -alias frigy \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile path is relative to the android/ directory:
storeFile=../frigy-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=frigy
keyPassword=YOUR_KEY_PASSWORD
